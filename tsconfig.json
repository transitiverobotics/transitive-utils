{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "declaration": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["index.ts", "common/**/*.ts", "server/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
