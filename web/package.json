{
  "name": "@transitive-sdk/utils-web",
  "version": "0.18.0",
  "description": "Web utils for the Transitive framework",
  "homepage": "https://transitiverobotics.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/transitiverobotics/transitive-utils.git",
    "directory": "web"
  },
  "author": {
    "name": "Christian Fritz",
    "email": "christian@transitiverobotics.com"
  },
  "keywords": [
    "robotics"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/utils-web.cjs",
  "module": "./dist/utils-web.mjs",
  "types": "./dist/utils-web.d.cts",
  "exports": {
    ".": {
      "types": "./dist/utils-web.d.cts",
      "import": {
        "types": "./dist/utils-web.d.mts",
        "default": "./dist/utils-web.mjs"
      },
      "require": {
        "types": "./dist/utils-web.d.cts",
        "default": "./dist/utils-web.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "prepare": "npm run build && cd css && npx cleancss -o bootstrap_transitive-bs-root.min.css bootstrap_transitive-bs-root.css",
    "prepack": "cat ../docs.js | node --input-type=module - client",
    "dev": "node esbuild.js"
  },
  "dependencies": {
    "bootstrap": "^4.6.0",
    "chalk": "^4.1.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "loglevel": "^1.8.0",
    "loglevel-plugin-prefix": "^0.8.4",
    "mqtt": "^5.10.1",
    "react-shadow-dom-retarget-events": "^1.0.8",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "clean-css-cli": "^5.6.3",
    "cors": "^2.8.5",
    "esbuild": "^0.28.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "websocket-stream": "^5.3.0"
  }
}
