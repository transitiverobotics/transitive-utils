{
  "name": "@transitive-sdk/utils",
  "version": "0.18.0",
  "description": "Utils for the Transitive framework",
  "homepage": "https://transitiverobotics.com",
  "repository": "github:transitiverobotics/transitive-utils",
  "author": {
    "name": "Christian Fritz",
    "email": "christian@transitiverobotics.com"
  },
  "keywords": [
    "robotics"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./common/datacache": "./common/datacache/index.js",
    "./*.js": "./*.js",
    "./*.json": "./*.json",
    "./*": "./*.js"
  },
  "scripts": {
    "test": "cd test && node --test --watch",
    "testMqttSync": "node --test --watch test/MqttSync.test.js",
    "testCloud": "cd cloud && node --test --watch *.test.js",
    "prepack": "cat docs.js | node --input-type=module - server common && node scripts/generate-package-entries.js"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "loglevel": "^1.8.0",
    "loglevel-plugin-prefix": "^0.8.4",
    "mqtt": "^5.15.1",
    "semver": "^7.3.5"
  },
  "devDependencies": {
    "aedes": "^0.46.2",
    "documentation": "^14.0.2",
    "expect": "^28.1.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "auto-update": "./bin/auto-update.js"
  }
}
