{
  "name": "@transitive-sdk/datacache",
  "version": "0.14.1",
  "description": "A class for storing data in a JSON object with change detection and change notifications. Ideal for building data-syncs.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "homepage": "https://transitiverobotics.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/transitiverobotics/transitive-utils.git",
    "directory": "common/datacache"
  },
  "author": {
    "name": "Christian Fritz",
    "email": "christian@transitiverobotics.com"
  },
  "keywords": [
    "robotics"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "prepare": "npm run build",
    "test": "echo 'See test in parent folder'",
    "prepack": "cat generateDocs.js | node --input-type=module"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
